proc xspi_generate {drv_handle} {
	generate_memory_node_for_ip $drv_handle

	set node [get_node $drv_handle]
	if {[string_is_empty $node]} {
		return
	}
	set dts_file [set_drv_def_dts $drv_handle]
	set tree_obj [return_tree_obj $drv_handle]

	# Delete all the properties generated by the common code for xspi node
	# except the ones listed below. Only few properties among the ones exposed
	# by IP is meaningful for the driver.
	set prop_list [list \
		"compatible" "reg" "interrupts" "interrupt-parent" "interrupt-names" \
		"clock-names" "clocks" "power-domains" "resets" "reset-names" \
		"status" "#address-cells" "#size-cells" \
		"ranges" "num-cs" "dma-coherent" "xlnx,ip-name" "xlnx,name"]

	set values [$tree_obj getall $node]
	foreach {prop _} $values {
		if {[lsearch -exact $prop_list $prop] < 0} {
			catch {$tree_obj unset $node $prop}
		}
	}

	# The generic pass derives the compatible from the IP name and version.
	# Replace it with the string the driver binds against.
	$tree_obj unset $node compatible
	$tree_obj set $node compatible "\"amd,axi-xspi\""

	# User parameters that describe the core itself. These are present
	# whichever AXI interface is configured, and the driver needs all of
	# them to talk to the target: the SPI mode selects the protocol, the
	# clock is the external frequency divided by the SCK ratio scaled by
	# the standard mode multiplier, and the FIFO depth bounds a transfer.
	# Naming them here states which parameters the driver depends on, and
	# fixes their type so that a value cannot come out as hex.

	set conf_props [list \
		"C_SPI_MODE" \
		"C_XIP_PERF_MODE" \
		"C_AXI_LITE_INTERFACE" \
		"C_SELECT_DIFF_CLK" \
		"C_SCK_RATIO" \
		"C_MULTIPLE16" \
		"C_FIFO_DEPTH" \
		"C_SPI_MEMORY" \
		"C_NUM_SS_BITS" \
		"C_ENABLE_ECC" \
		"C_USE_STARTUP" \
		"C_EXT_SPI_CLK_FREQ" \
		"C_ENABLE_HWRESET"]

	# Common code generates the properties with "xlnx," prefix.
	# New drivers are expected to have "amd," prefix.

	foreach cfg_prop $conf_props {
		set dt_prop $cfg_prop
		regsub -all {^C_} $dt_prop {} dt_prop
		regsub -all {_} $dt_prop {-} dt_prop
		set dt_prop "amd,[string tolower $dt_prop]"
		set value [hsi get_property CONFIG.${cfg_prop} $drv_handle]
		if {![string_is_empty $value]} {
			add_prop $node $dt_prop $value int $dts_file
		}
	}

}
